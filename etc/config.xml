<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:App/Config/etc/config.xsd">
    <default>
        <currency_converter>
            <general>
                <api_url>https://api.frankfurter.dev/v2/</api_url>
                <default_currency_from>AED</default_currency_from>
                <default_currency_to>LKR</default_currency_to>
                <curl_time_out>10</curl_time_out>
                <asset_type>1</asset_type>
            </general>
        </currency_converter>
    </default>
</config>
